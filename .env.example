COMPOSE_PROJECT_NAME=phantomx-puzzle
ROS_DOMAIN_ID=31
DOCKER_PLATFORM=linux/amd64
MOTION_IMAGE=ghcr.io/ping152/phantomx-puzzle-motion:v0.1.0-rc1
VISION_IMAGE=ghcr.io/ping152/phantomx-puzzle-vision:v0.1.0-rc1
ENABLE_RVIZ=true
DISPLAY=:0
VISION_MODE=mock
VISION_SHOW_WINDOW=true
CM530_DEVICE=/dev/ttyUSB0
CM530_CONTAINER_DEVICE=/dev/ttyUSB0
CAMERA_DEVICE=/dev/video0
CAMERA_DEVICE_ID=0
HARDWARE_OWNER=
RELEASE_MODE=0
ROS_DISCOVERY_SERVER=
